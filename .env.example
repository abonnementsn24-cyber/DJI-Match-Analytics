# ==============================================================================
# EMDJI Match Analytics — variables d'environnement
#
# Copiez ce fichier en `.env` (racine, pour docker-compose) et/ou
# `backend/.env` (pour un lancement local du backend sans Docker), puis
# ajustez les valeurs. Rien ici n'est une vraie clé — ce sont des exemples.
# ==============================================================================

# ---- Base de données -------------------------------------------------------
# SQLite par défaut (développement local uniquement).
# En production (Docker Compose), une URL PostgreSQL est injectée automatiquement.
DATABASE_URL=sqlite:///./match_analytics.db
# Exemple PostgreSQL: postgresql+psycopg2://emdji:emdji@localhost:5432/emdji_match_analytics

# Identifiants Postgres utilisés par docker-compose.yml (service `postgres`)
POSTGRES_USER=emdji
POSTGRES_PASSWORD=emdji
POSTGRES_DB=emdji_match_analytics

# ---- Fournisseur de données football (football-data.org, API v4) ----------
# Laissez vide pour rester en mode démo (données fictives, aucune fonctionnalité
# perdue à part les vraies données). Créez une clé gratuite sur
# https://www.football-data.org/ pour passer en données réelles.
FOOTBALL_DATA_API_KEY=

# ---- Sécurité admin ---------------------------------------------------------
# Protège les endpoints /api/v1/admin/*. Laissé vide en développement local ;
# définissez une valeur forte en production.
ADMIN_API_TOKEN=

# ---- Application -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Feature engineering / modèle -------------------------------------------
FORM_WINDOW_SHORT=5
FORM_WINDOW_LONG=10
H2H_MAX_MATCHES=5
MIN_MATCHES_FOR_PREDICTION=5

ELO_INITIAL_RATING=1500
ELO_HOME_ADVANTAGE=65
ELO_K_FACTOR=20

# Poids de l'Ensemble (doivent sommer à 1.0) — valeurs de départ, à ajuster
# uniquement à partir de vrais résultats de /api/v1/backtesting, jamais à la main.
ENSEMBLE_WEIGHT_BASIC=0.3333
ENSEMBLE_WEIGHT_FORM=0.3333
ENSEMBLE_WEIGHT_ELO=0.3334

# ---- Frontend ----------------------------------------------------------------
# URL de l'API vue par le serveur Next.js (Server Components) — en local,
# http://localhost:8000 ; via docker-compose, http://backend:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
